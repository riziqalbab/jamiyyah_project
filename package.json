{
  "name": "jamiyyah-project",
  "version": "0.1.0",
  "private": true,
  "description": "Open-Source Islamic Knowledge Retrieval Engine with Strict Grounding & Verifiable Scholarly References",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:web": "bun run -b --cwd apps/web build",
    "dev:web": "bun run -b --cwd apps/web dev",
    "dev:ui": "node scripts/run-py.mjs apps/api/server.py --port 8765",
    "rag:index": "node scripts/run-py.mjs -m jamiyyah_rag.indexer --init-db",
    "rag:index:all": "node scripts/run-py.mjs -m jamiyyah_rag.indexer --init-db --include-hadith",
    "test:py": "node scripts/run-py.mjs --test",
    "validate:samples": "node scripts/run-py.mjs -m jamiyyah_schema datasets/samples/canonical_sample.jsonl"
  }
}
