# Database & Vector Store (pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jamiyyah
VECTOR_BACKEND=pgvector
PGVECTOR_TABLE=chunk_embeddings
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# EEMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=google/gemini-embedding-2
EMBEDDING_API_KEY=""


# Reranker Threshold
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MIN_SCORE=0.65

# LLM Provider (OpenAI-compatible cloud: OpenAI / OpenRouter / Groq / DeepSeek / Gemini OpenAI-compat)
LLM_PROVIDER=openai_compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# External Dataset Storage (Hugging Face Hub / S3-compatible R2)
HF_TOKEN=
HF_DATASET_REPO=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
