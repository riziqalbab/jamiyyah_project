# =========================
# Datasets & Large Artifacts
# =========================
# Ignore raw and parsed full datasets; keep folder structure via .gitkeep
# and small examples under datasets/samples/
datasets/unparsed/*
!datasets/unparsed/.gitkeep
datasets/parsed/*
!datasets/parsed/.gitkeep

# Guard against accidentally committing large data/model files elsewhere
*.bok
*.sqlite
*.sqlite3
*.db
*.parquet
*.arrow
*.safetensors
*.onnx
models/
qdrant_storage/

# =========================
# Python & Jupyter
# =========================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# =========================
# Node.js / TypeScript (API & Web)
# =========================
node_modules/
.next/
.turbo/
.pnpm-store/
*.tsbuildinfo
out/

# =========================
# Environment & Secrets
# =========================
.env
.env.*
!.env.example

# =========================
# OS & Logs
# =========================
.DS_Store
Thumbs.db
*.log
